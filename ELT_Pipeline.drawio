        <!-- AIRFLOW DAG TASKS -->
        <mxCell id="dag" value="&lt;b&gt;EXAMPLE AIRFLOW DAG TASKS&lt;/b&gt;&lt;br&gt;extract_pos → extract_app → extract_crm&lt;br&gt;↓&lt;br&gt;load_raw → validate_data → clean_staging&lt;br&gt;↓&lt;br&gt;update_dimensions → update_supplier_scd2&lt;br&gt;↓&lt;br&gt;load_fact_sales → load_fact_inventory&lt;br&gt;↓&lt;br&gt;quality_checks → refresh_bi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="390" height="260" as="geometry"/>
