        <mxCell id="title" value="MODERN ELT PIPELINE — POS, APP &amp; CRM TO BI" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
