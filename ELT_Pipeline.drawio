        </mxCell>

        <!-- RAW TO STAGING -->
        <mxCell id="e5" value="Clean &amp; Validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="raw" target="staging">
